{
  "name": "collective-ai-tools",
  "version": "1.0.0",
  "description": "A comprehensive platform featuring both curated external AI tools and powerful AI workspace tools for developers, researchers, and enthusiasts.",
  "type": "module",
  "license": "MIT",
  "author": "Collective AI Tools Team",
  "homepage": "https://collectiveai.tools",
  "repository": {
    "type": "git",
    "url": "https://github.com/Hyraze/collective-ai-tools.git"
  },
  "bugs": {
    "url": "https://github.com/Hyraze/collective-ai-tools/issues"
  },
  "keywords": [
    "ai",
    "artificial-intelligence",
    "tools",
    "automation",
    "workflow",
    "agents",
    "mcp",
    "directory",
    "react",
    "typescript",
    "open-source"
  ],
  "scripts": {
    "dev": "vite",
    "prebuild": "node scripts/copy-readme.mjs",
    "build": "vite build",
    "preview": "vite preview",
    "type-check": "tsc --noEmit",
    "lint": "eslint . --fix",
    "lint:check": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "clean": "node scripts/clean.mjs",
    "test": "vitest run",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest --coverage",
    "test:watch": "vitest --watch",
    "security:check": "node scripts/security-check.js",
    "security:audit": "pnpm audit --audit-level moderate",
    "deps:check": "pnpm outdated",
    "deps:update": "pnpm update --latest && pnpm audit --fix",
    "deploy": "vercel --prod",
    "deploy:preview": "vercel"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.8.0",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^22.18.3",
    "@types/react": "^18.3.24",
    "@types/react-dom": "^18.3.7",
    "@typescript-eslint/eslint-plugin": "^8.65.0",
    "@typescript-eslint/parser": "^8.65.0",
    "@vitejs/plugin-react": "^6.0.4",
    "@vitest/coverage-v8": "^4.1.10",
    "baseline-browser-mapping": "^2.9.11",
    "eslint": "^9.39.2",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "globals": "^17.0.0",
    "happy-dom": "^20.11.1",
    "msw": "^2.15.0",
    "playwright": "^1.61.1",
    "postcss": "^8.5.23",
    "prettier": "^3.6.2",
    "tailwindcss": "^4.3.3",
    "typescript": "~5.7.3",
    "typescript-eslint": "^8.65.0",
    "vercel": "^57.0.0",
    "vite": "^8.1.5",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^4.1.10",
    "workbox-build": "7.4.1",
    "workbox-window": "7.4.1"
  },
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=8.0.0"
  },
  "dependencies": {
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "isomorphic-dompurify": "3.19.0",
    "lucide-react": "^0.544.0",
    "posthog-js": "^1.404.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.18.1",
    "rehype-raw": "^7.0.0",
    "rehype-sanitize": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "tailwind-merge": "^3.3.1",
    "zod": "^4.3.4"
  },
  "msw": {
    "workerDirectory": [
      "public"
    ]
  }
}
